            "MT (dB)", "rostrocaudal (X)", "mediolateral (Y)", "block_type", 
        ]
    },
    "key_variables": {
        "spikes": "Time of neuronal spike relative to stimulus onset (s)",
        "trial": "Trial identifier",
        "freq": "Frequency of presented tone (kHz)",
        "condition": "Stimulus type: 1 (standard), 2 (deviant)",
        "animal": "Unique subject ID",
        "division": "Cortical sub-region (e.g., A1, AAF)",
